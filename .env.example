# Platform settings.
#   On your computer: copy this file to .env.local      With Docker (docker compose): copy it to .env
# Both files are git-ignored: never commit real keys. If a value contains $ or #, wrap it in 'single quotes'.

# ---- Required ---------------------------------------------------------------------------------
# Higgsfield API key from the Higgsfield console, in key-id:key-secret format. Stays on the server.
HF_CREDENTIALS=
# Who gets the Admin dashboard (comma-separated). Sign up on the site with one of these addresses.
ADMIN_EMAILS=
# The site's public address, e.g. https://video.adronstore.in (required for Docker; leave empty on your computer).
# Payment return pages and email links use it, and Docker's HTTPS certificate is issued for its domain.
PUBLIC_URL=

# ---- Brand and contact (shown on the Contact and policy pages; payment providers check these) ---
# APP_NAME=Adron Video Engine
# Accent color for buttons and highlights, e.g. your logo's color (default: lime #c8f542).
# BRAND_COLOR=#c8f542
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_NAME=
# Use \n for line breaks, inside double quotes: "Shop 1, Main Road\nNew Delhi 110001"
BUSINESS_ADDRESS=

# ---- Prices (Admin -> Pricing sets a price per second for every model; saved prices then win) --
# These two set Seedance 2.5's starting prices: 0.40 per second at 720p makes a 30-second 720p video 12.00.
CURRENCY=USD
PRICE_PER_SECOND_720P=0.40
PRICE_PER_SECOND_480P=0.30
# Credit packs customers can buy, in CURRENCY.
CREDIT_PACKS=12,36,60,120
# Free credit for every new account (0 = none). It costs you real Higgsfield credit.
SIGNUP_BONUS=0

# ---- Payments: stripe, razorpay or manual (default: whichever keys below are set, else manual) -
PAYMENT_PROVIDER=
# Stripe (cards worldwide). Dashboard -> Developers -> API keys, and a webhook (see README).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (India: UPI, cards, net banking, wallets). Dashboard -> Account & Settings -> API keys / Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# With manual payments, customers see this instead of a checkout, and you add credit in Admin -> Customers.
MANUAL_PAYMENT_NOTE=

# ---- Email (password-reset links) ----------------------------------------------------------------
# smtps://user:password@smtp.example.com:465 (or smtp://...:587). "log" prints emails in the server log instead.
SMTP_URL=
# Sender, e.g. "Adron Video <support@adronstore.in>". Default: the app name and SUPPORT_EMAIL.
MAIL_FROM=

# ---- Limits --------------------------------------------------------------------------------------
MAX_ACTIVE_JOBS_PER_USER=20
MAX_PROMPTS_PER_REQUEST=100

# ---- Server (docker-compose.yml already sets these) ---------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=data
# Set to 1 behind a reverse proxy (Caddy, Nginx, Cloudflare) so rate limits see visitors' real IPs.
# TRUST_PROXY=0
# Extra host names to accept, comma-separated.
# ALLOWED_HOSTS=
# HF_BASE_URL=https://api.higgsfield.ai
