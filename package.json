{
  "name": "adron-video-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI for Seedance 2.5 video generation on the Higgsfield API: long prompts, batches and image references",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/main.ts",
    "build": "vite build",
    "start": "tsx server/main.ts --production",
    "example": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "backup": "tsx server/backup.ts"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "nodemailer": "^10.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
